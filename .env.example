AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Leda
MONGO_URI=mongodb://localhost:27017
CORS_ALLOWED_ORIGINS=
SHORTLIST_THRESHOLD=80
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Auth (seeded Super Admin)
SUPER_ADMIN_EMAIL=admin@aihiring.com
SUPER_ADMIN_PASSWORD=change_me
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Hiring Platform

# Email provider: "smtp" (default) or "sendgrid" (HTTPS API — works on Render
# Free tier where outbound SMTP ports 25/465/587 are blocked).
# For sendgrid: set EMAIL_PROVIDER=sendgrid and SENDGRID_API_KEY. The sender is
# taken from SMTP_FROM_EMAIL/SMTP_FROM_NAME (must be verified in SendGrid).
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
# EMAIL_API_TIMEOUT=15
