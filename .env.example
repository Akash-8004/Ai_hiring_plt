AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Leda
MONGO_URI=mongodb://localhost:27017
CORS_ALLOWED_ORIGINS=
SHORTLIST_THRESHOLD=80
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Auth (seeded Super Admin)
SUPER_ADMIN_EMAIL=admin@aihiring.com
SUPER_ADMIN_PASSWORD=change_me
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Hiring Platform

# Email provider: "smtp" (default), "brevo" (recommended for production),
# or "sendgrid" (commented out in code).
#
# brevo: HTTPS API (port 443) — works on Render Free tier where outbound SMTP
# ports 25/465/587 are blocked. Free tier: 300 emails/day forever.
#   1. Sign up at https://www.brevo.com (free, no credit card)
#   2. Settings -> Senders -> add + verify your sender email
#   3. Settings -> SMTP & API -> API Keys -> generate key
#   Sender is taken from SMTP_FROM_EMAIL/SMTP_FROM_NAME (must be verified in Brevo).
#
# sendgrid: to re-enable, uncomment the sendgrid code blocks in
# backend/services/email_service.py and set EMAIL_PROVIDER=sendgrid.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_API_TIMEOUT=15

# Public origin of the React frontend — used in interview/portal links
FRONTEND_URL=http://localhost:5173

# Resume OCR & Async Processing Queue
OCR_ENABLED=true
OCR_MAX_FILE_MB=10
OCR_MAX_PAGES=10
OCR_TIMEOUT_SECONDS=60
OCR_CONCURRENCY=3
OCR_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
RESUME_JOB_TTL_HOURS=24
RESUME_JOB_LEASE_SECONDS=300
